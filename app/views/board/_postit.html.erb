<%
  state    = state_meta(p.display_status)
  stale    = staleness_meta(p.staleness)
  stale_lvl = staleness_label(p.staleness)
  avatar   = avatar_for(p.assignee)
  days     = days_in_state(p)
  step_idx = state_step_index(p.display_status)
  step_total = state_total_steps
  age_show = p.staleness != :fresh
  card_style = +"--pg-state-color:#{state[:color]};"
  card_style << "--pg-card-border:#{stale[:border]};"
  card_style << "--pg-paper:#{stale[:paper]};"
  card_style << "--pg-avatar-ring:#{stale[:paper]};"
  data_attrs = {
    assignee: p.assignee.to_s,
    display_status: p.display_status.to_s,
    staleness: p.staleness.to_s,
    search: [p.jira_key, p.summary, p.assignee, state[:label]].compact.join(" ").downcase,
    board_target: "card",
    action: "mouseenter->board#showTooltip mouseleave->board#hideTooltip",
    tooltip_id: p.jira_key,
    tooltip_title: p.summary,
    tooltip_type: p.issue_type.to_s,
    tooltip_state: state[:label],
    tooltip_state_color: state[:color],
    tooltip_assignee: avatar[:name],
    tooltip_days: days.to_s,
    tooltip_stale: stale_lvl,
    tooltip_priority: priority_label(p.priority),
    tooltip_status_raw: p.jira_status.to_s
  }
  data_attrs[:critical] = "1" if stale_lvl == "critical"
%>
<%= link_to jira_url(p.jira_key),
            data: data_attrs,
            class: "pg-card",
            style: card_style,
            target: "_blank",
            rel: "noreferrer" do %>
  <div class="pg-card-row1">
    <%= type_icon_svg(p.issue_type, size: 14) %>
    <span class="pg-card-id"><%= p.jira_key %></span>
    <span class="pg-card-meta">
      <span class="pg-step-chip" style="color:<%= state[:deep] %>;background:<%= state[:tint] %>;">
        <%= step_idx %><span>/<%= step_total %></span>
      </span>
      <%= priority_flag_svg(p.priority, size: 13) %>
      <% if age_show && days %>
        <span class="pg-age" style="background:<%= stale[:bg] %>;color:<%= stale[:fg] %>;">
          <span class="dot" style="background:<%= stale[:dot] %>;"></span><%= days %>d
        </span>
      <% end %>
    </span>
  </div>
  <div class="pg-card-title"><%= p.summary %></div>
  <div class="pg-card-row2">
    <span class="pg-card-avatar-wrap">
      <span class="pg-avatar"
            style="background:<%= avatar[:color] %>;width:20px;height:20px;font-size:8.4px;"
            title="<%= avatar[:name] %>">
        <%= avatar[:initials] %>
      </span>
    </span>
  </div>
  <div class="pg-ladder">
    <% BoardHelper::DISPLAY_STATES.each_with_index do |s, i| %>
      <span style="background:<%= i <= step_idx ? s[:color] : '#e7eaee' %>;"></span>
    <% end %>
  </div>
<% end %>
