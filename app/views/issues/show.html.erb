<%
  state = state_meta(@display_status)
  step_idx = state_step_index(state[:id])
  step_total = state_total_steps
  pr_label = priority_label(@issue.priority)
  pr_color = priority_color(@issue.priority)
  bucket_label =
    case @staleness
    when :really then "critical"
    when :somewhat then "stale"
    else "fresh"
    end
  bucket_color =
    case @staleness
    when :really then "#b91c1c"
    when :somewhat then "#c2410c"
    else "#1e2430"
    end
  days = if @issue.status_changed_at_jira || @issue.created_at_jira
           t = @issue.status_changed_at_jira || @issue.created_at_jira
           ((Time.current - t) / 1.day).to_i
         end
  jira = jira_url(@issue.jira_key)
  av = avatar_for(@issue.assignee_username)
  accent = @epic_accent || state[:color]
%>
<%= turbo_frame_tag "modal" do %>
  <div class="pg-modal-backdrop"
       data-controller="modal"
       data-action="click->modal#closeIfBackdrop keydown@window->modal#closeOnEsc">
    <div class="pg-modal" data-action="click->modal#stop">
      <div class="pg-modal-accent" style="background:<%= accent %>;"></div>
      <div class="pg-modal-body">
        <div class="pg-modal-head">
          <%= type_icon_svg(@issue.issue_type, size: 18) %>
          <span class="pg-modal-id"><%= @issue.jira_key %></span>
          <span class="pg-modal-state-pill" style="background:<%= state[:color] %>;">
            <%= state[:label] %>
          </span>
          <button class="pg-modal-close"
                  type="button"
                  aria-label="Close"
                  data-action="modal#close">×</button>
        </div>
        <div class="pg-modal-title"><%= @issue.summary %></div>

        <div class="pg-stepper-box"
             style="--pg-step-color:<%= state[:color] %>;--pg-step-tint:<%= state[:tint] %>;--pg-step-deep:<%= state[:deep] %>;">
          <div class="pg-stepper">
            <% BoardHelper::DISPLAY_STATES.each_with_index do |s, i| %>
              <% reached = i <= step_idx %>
              <% phase = i < step_idx ? "done" : (i == step_idx ? "current" : "todo") %>
              <% if i > 0 %>
                <div class="pg-stepper-line"
                     data-reached="<%= reached ? '1' : '0' %>"
                     style="background:<%= reached ? s[:color] : '#e7e9ee' %>;"></div>
              <% end %>
              <div class="pg-stepper-step" data-state="<%= phase %>" title="<%= s[:label] %>"
                   style="--pg-step-color:<%= s[:color] %>;--pg-step-tint:<%= s[:tint] %>;">
                <div class="pg-stepper-dot"></div>
              </div>
            <% end %>
          </div>
          <div class="pg-stepper-labels">
            <% BoardHelper::DISPLAY_STATES.each_with_index do |s, i| %>
              <span data-current="<%= i == step_idx ? '1' : '0' %>"><%= s[:short] %></span>
            <% end %>
          </div>
        </div>

        <div class="pg-modal-meta-grid">
          <div>
            <div class="pg-meta-lbl">Epic</div>
            <div class="pg-meta-val">
              <span style="width:9px;height:9px;border-radius:2px;background:<%= accent %>;display:inline-block;"></span>
              <%= @issue.epic.name %>
            </div>
          </div>
          <div>
            <div class="pg-meta-lbl">Assignee</div>
            <div class="pg-meta-val">
              <span class="pg-avatar"
                    style="background:<%= av[:color] %>;width:20px;height:20px;font-size:8.4px;">
                <%= av[:initials] %>
              </span>
              <%= av[:name] %>
            </div>
          </div>
          <div>
            <div class="pg-meta-lbl">Priority</div>
            <div class="pg-meta-val">
              <%= priority_flag_svg(@issue.priority, size: 14) %>
              <span style="color:<%= pr_color %>;"><%= pr_label %></span>
            </div>
          </div>
          <div>
            <div class="pg-meta-lbl">Age in state</div>
            <div class="pg-meta-val" style="color:<%= bucket_color %>;">
              <% if days %><%= days %> days<% else %>—<% end %>
              <% unless bucket_label == "fresh" %> · <%= bucket_label %><% end %>
            </div>
          </div>
          <div>
            <div class="pg-meta-lbl">Jira status</div>
            <div class="pg-meta-val"><%= @issue.jira_status %></div>
          </div>
          <div>
            <div class="pg-meta-lbl">Type</div>
            <div class="pg-meta-val">
              <%= type_icon_svg(@issue.issue_type, size: 14) %>
              <%= @issue.issue_type %>
            </div>
          </div>
        </div>

        <div class="pg-modal-actions">
          <a href="<%= jira %>" target="_blank" rel="noreferrer" class="pg-jira-btn">
            Open in Jira
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 3h6v6M10 3L3 10"/>
            </svg>
          </a>
          <span class="pg-jira-url"><%= jira.sub(%r{^https?://}, "") %></span>
        </div>
      </div>
    </div>
  </div>
<% end %>
