<%
  epic = column.epic
  all_issues  = column.all_issues
  total       = all_issues.size
  todo_count  = column.new_issues.size
  done_count  = column.done_issues.size
  middle_count = column.middle_groups.values.sum(&:size)
  stale_count = column.middle_groups.values.flatten.count { |p| %i[somewhat really].include?(p.staleness) }

  # epic accent: pick a stable color from key hash
  accent_palette = %w[#6366f1 #e11d48 #d97706 #0ea5e9 #8b5cf6 #0d9488 #10b981 #ea580c #c026d3 #64748b]
  accent = accent_palette[(epic.jira_key.to_s.bytes.sum % accent_palette.size)]

  # mini distribution: bucket all issues by display_status
  dist_buckets = BoardHelper::DISPLAY_STATES.map { |s|
    n = all_issues.count { |p| p.display_status == s[:id] }
    [s, n]
  }.select { |_, n| n > 0 }

  # state.id used by status filter highlight bookkeeping (data-state attr)
%>
<section class="pg-col"
         data-epic-key="<%= epic.jira_key %>"
         data-controller="stack"
         data-stack-todo-open-value="false"
         data-stack-done-open-value="false">
  <div class="pg-col-head">
    <div class="pg-col-accent" style="background:<%= accent %>;"></div>
    <div class="pg-col-title-row">
      <span class="pg-col-name" title="<%= epic.name %>"><%= epic.name %></span>
      <span class="pg-col-count"><%= total %></span>
    </div>
    <div class="pg-col-meta">
      <span class="pg-col-key"><%= epic.jira_key %></span>
      <% if stale_count > 0 %>
        <span class="pg-col-stale">⚠ <%= stale_count %> stale</span>
      <% end %>
    </div>
    <div class="pg-dist" aria-hidden="true">
      <% dist_buckets.each do |s, n| %>
        <span title="<%= s[:label] %>: <%= n %>" style="flex:<%= n %>;background:<%= s[:color] %>;"></span>
      <% end %>
    </div>
  </div>

  <div class="pg-col-body">
    <% if todo_count > 0 %>
      <div class="pg-stack-wrap" data-stack-target="todoWrap">
        <div class="pg-stack-shadow" data-stack-target="todoShadow"></div>
        <button type="button"
                class="pg-stack-btn"
                style="--pg-stack-color:<%= state_meta('new')[:color] %>;"
                data-stack-target="todoBtn"
                data-action="stack#toggleTodo"
                data-open="0">
          <svg class="pg-stack-chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M3 2l4 3-4 3" stroke="#64748b" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true">
            <circle cx="5.5" cy="5.5" r="4" fill="none" stroke="#94a3b8" stroke-width="1.5"/>
          </svg>
          <span class="pg-stack-count"><%= todo_count %></span>
          <span class="pg-stack-label">To Do</span>
          <span class="pg-stack-trail" data-stack-target="todoTrail">show</span>
        </button>
        <div class="pg-stack-body" data-stack-target="todoBody" hidden>
          <% column.new_issues.each do |pp| %>
            <%= render "board/postit", p: pp %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if middle_count > 0 && todo_count > 0 %>
      <div class="pg-divider" data-stack-target="middleDivider" hidden>
        <span class="pg-divider-text" style="color:#94a3b8;">IN PROGRESS</span>
        <span class="pg-divider-line"></span>
      </div>
    <% end %>

    <% column.middle_groups.each do |display_status, postits| %>
      <% next if postits.empty? %>
      <% st = state_meta(display_status) %>
      <% if column.middle_groups.size > 1 %>
        <div class="pg-divider">
          <span class="pg-divider-text" style="color:<%= st[:deep] %>;"><%= st[:label].upcase %></span>
          <span class="pg-divider-line"></span>
        </div>
      <% end %>
      <% postits.each do |pp| %>
        <%= render "board/postit", p: pp %>
      <% end %>
    <% end %>

    <% if done_count > 0 %>
      <div class="pg-stack-wrap" data-stack-target="doneWrap">
        <div class="pg-stack-shadow" data-stack-target="doneShadow"></div>
        <button type="button"
                class="pg-stack-btn"
                style="--pg-stack-color:<%= state_meta('done')[:color] %>;"
                data-stack-target="doneBtn"
                data-action="stack#toggleDone"
                data-open="0">
          <svg class="pg-stack-chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M3 2l4 3-4 3" stroke="#64748b" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <svg width="11" height="11" viewBox="0 0 11 11" aria-hidden="true">
            <path d="M3 5.7l1.8 1.8L8.2 4" stroke="#22c55e" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="pg-stack-count"><%= done_count %></span>
          <span class="pg-stack-label">Done</span>
          <span class="pg-stack-trail" data-stack-target="doneTrail">show</span>
        </button>
        <div class="pg-stack-body" data-stack-target="doneBody" hidden>
          <% column.done_issues.each do |pp| %>
            <%= render "board/postit", p: pp %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
