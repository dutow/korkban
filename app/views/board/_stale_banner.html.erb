<% if last_sync.nil? %>
  <span class="pg-sync" title="No sync yet"><span class="dot dot-amber"></span>No sync yet</span>
<% else %>
  <% age_min = ((Time.current - last_sync.finished_at) / 60).to_i %>
  <% level = age_min > 30 ? :red : age_min > 5 ? :amber : :green %>
  <span class="pg-sync" title="Last sync: <%= last_sync.finished_at.iso8601 %> (<%= age_min %> min ago)">
    <span class="dot dot-<%= level %>"></span>
    <% if level == :red %>
      JIRA sync stalled (<%= age_min %>m)
    <% elsif level == :amber %>
      <%= age_min %>m ago
    <% else %>
      synced
    <% end %>
  </span>
<% end %>
