<%= turbo_stream_from "board" %>

<%
  all_issues   = @presenter.columns.flat_map(&:all_issues)
  total_tickets = all_issues.size
  total_stale  = all_issues.count { |p| %i[somewhat really].include?(p.staleness) }

  # people filter options: union of configured users and active assignees,
  # plus an "Unassigned" sentinel (data-name="") for tickets with no assignee.
  configured_usernames = PGBOARD_CONFIG.board.users.map { |u| u.jira_username.to_s }
  active_assignees     = all_issues.map(&:assignee).map(&:to_s)
  assignees = (configured_usernames + active_assignees).reject(&:empty?).uniq.sort
%>

<div class="pg-shell"
     data-controller="board"
     data-board-statuses-value="[]"
     data-board-assignees-value="[]"
     data-board-query-value=""
     data-board-activity-value="{}">

  <header class="pg-header">
    <div class="pg-brand">
      <span class="pg-brand-name">pgboard</span>
      <span class="pg-brand-sub">Priority queue</span>
    </div>

    <div class="pg-status-pills" role="group" aria-label="Filter by status">
      <% @presenter.configured_display_statuses.each do |id| %>
        <% s = state_meta(id) %>
        <button type="button"
                class="pg-pill"
                data-board-target="statusPill"
                data-action="board#toggleStatus"
                data-state="<%= s[:id] %>"
                data-color="<%= s[:color] %>"
                data-on="0"
                style="--pg-state-color:<%= s[:color] %>;"
                title="Highlight <%= s[:label] %>">
          <span class="pg-pill-dot" style="background:<%= s[:color] %>;"></span>
          <span><%= s[:short] %></span>
        </button>
      <% end %>
      <button type="button"
              class="pg-pill-clear"
              data-board-target="statusClear"
              data-action="board#clearStatuses"
              hidden>✕ clear</button>
    </div>

    <div class="pg-activity-pills" role="group" aria-label="Highlight by activity">
      <% @activity_days.each do |days| %>
        <button type="button"
                class="pg-act-pill"
                data-board-target="activityPill"
                data-action="board#toggleActivity"
                data-dir="newer"
                data-days="<%= days %>"
                data-on="0"
                title="Highlight tickets updated within <%= pluralize(days, "day") %>">≤<%= days %>d</button>
      <% end %>
      <span class="pg-activity-sep" aria-hidden="true"></span>
      <% @activity_days.each do |days| %>
        <button type="button"
                class="pg-act-pill"
                data-board-target="activityPill"
                data-action="board#toggleActivity"
                data-dir="older"
                data-days="<%= days %>"
                data-on="0"
                title="Highlight tickets not updated in over <%= pluralize(days, "day") %>">≥<%= days %>d</button>
      <% end %>
    </div>

    <div class="pg-header-right">
      <span class="pg-counts">
        <%= total_tickets %> tickets ·
        <span class="stale"><%= total_stale %> stale</span>
      </span>

      <div class="pg-search-wrap">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="#94a3b8" stroke-width="1.6" aria-hidden="true">
          <circle cx="6" cy="6" r="4.2"/><path d="M9.2 9.2L13 13" stroke-linecap="round"/>
        </svg>
        <input type="search"
               class="pg-search"
               placeholder="Search tickets…"
               data-board-target="search"
               data-action="input->board#search"
               autocomplete="off">
      </div>

      <div class="pg-people"
           data-controller="people"
           data-action="click@window->people#closeIfOutside">
        <button type="button" class="pg-people-btn"
                data-people-target="btn"
                data-action="people#toggle"
                data-on="0">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="#64748b" stroke-width="1.5" aria-hidden="true">
            <circle cx="7" cy="4.5" r="2.3"/><path d="M2.5 12c0-2.5 2-4 4.5-4s4.5 1.5 4.5 4" stroke-linecap="round"/>
          </svg>
          <span data-people-target="label">People</span>
          <svg width="9" height="9" viewBox="0 0 9 9" fill="none" stroke="#94a3b8" stroke-width="1.6" aria-hidden="true">
            <path d="M2 3.5L4.5 6 7 3.5" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="pg-people-menu" data-people-target="menu" hidden>
          <% un = avatar_for("") %>
          <button type="button"
                  class="pg-people-row"
                  data-people-target="row"
                  data-action="people#toggleRow"
                  data-name=""
                  data-on="0">
            <span class="pg-avatar"
                  style="background:<%= un[:color] %>;width:22px;height:22px;font-size:9.2px;">
              <%= un[:initials] %>
            </span>
            <span class="name"><%= un[:name] %></span>
            <svg class="check" width="14" height="14" viewBox="0 0 14 14" hidden aria-hidden="true">
              <path d="M3 7.3l2.5 2.5L11 4.2" stroke="#2563eb" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <% assignees.each do |name| %>
            <% av = avatar_for(name) %>
            <button type="button"
                    class="pg-people-row"
                    data-people-target="row"
                    data-action="people#toggleRow"
                    data-name="<%= name %>"
                    data-on="0">
              <span class="pg-avatar"
                    style="background:<%= av[:color] %>;width:22px;height:22px;font-size:9.2px;">
                <%= av[:initials] %>
              </span>
              <span class="name"><%= av[:name] %></span>
              <svg class="check" width="14" height="14" viewBox="0 0 14 14" hidden aria-hidden="true">
                <path d="M3 7.3l2.5 2.5L11 4.2" stroke="#2563eb" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          <% end %>
          <button type="button" class="pg-people-clear"
                  data-people-target="clear"
                  data-action="people#clear"
                  hidden>Clear selection</button>
        </div>
      </div>

      <%= render "board/stale_banner", last_sync: @last_sync %>
      <%= render "board/warning_tray", warnings: @presenter.warnings %>

      <button type="button"
              class="pg-theme-btn"
              data-controller="theme"
              data-action="theme#toggle"
              title="Toggle dark / light theme"
              aria-label="Toggle theme">
        <svg class="pg-theme-sun" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="7.5" cy="7.5" r="3"/>
          <path d="M7.5 1v1.6M7.5 12.4V14M1 7.5h1.6M12.4 7.5H14M2.9 2.9l1.1 1.1M11 11l1.1 1.1M2.9 12.1L4 11M11 4l1.1-1.1"/>
        </svg>
        <svg class="pg-theme-moon" width="15" height="15" viewBox="0 0 15 15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12.5 9.2A5.3 5.3 0 0 1 5.8 2.5a5.3 5.3 0 1 0 6.7 6.7z"/>
        </svg>
      </button>

      <span class="pg-user"><%= current_user_email %></span>
      <%= button_to "Logout", "/logout", method: :delete,
                    form: { style: "display:inline;margin:0;" },
                    class: "pg-logout-btn" %>
    </div>
  </header>

  <main class="pg-board" id="board-root" data-board-target="root">
    <% @presenter.columns.each do |col| %>
      <%= render "board/column", column: col %>
    <% end %>
  </main>

  <div data-board-target="tooltip" class="pg-tt" hidden></div>
</div>
